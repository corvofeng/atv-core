<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary text (current value) on a focusable row. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/text_secondary_on_focus" android:state_focused="true" />
    <item android:color="@color/text_secondary_on_focus" android:state_pressed="true" />
    <item android:color="@color/text_secondary" />
</selector>
